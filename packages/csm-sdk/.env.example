# Integration test configuration (copy to .env, do not commit secrets)

# RPC endpoint forked by anvil (Hoodi recommended — both CSM + CM deployed, cheap)
TEST_RPC_URL=https://ethereum-hoodi-rpc.publicnode.com

# Chain ID the fork should report (default: 560048 = Hoodi; use 1 for mainnet)
TEST_CHAIN_ID=560048

# Optional pinned fork block — leave unset to use latest (recommended for CI nightly,
# pin a specific block when reproducing a flake or comparing against a known state).
# NOTE: pinning a historical block REQUIRES an archive RPC. The default publicnode
# endpoint is non-archive and serves only a ~128-block sliding window, so a pinned
# historical block fails with "Archive requests require a personal token". Leave this
# unset (fork latest) unless you have an archive endpoint.
# TEST_FORK_BLOCK=1234567

# Private key for the signer used by wallet tests.
# Defaults to anvil dev account #0 — DO NOT set a real key for local development.
# TEST_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
